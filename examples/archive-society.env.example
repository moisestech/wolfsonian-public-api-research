# COPY to .env.local on your own computer. Never put real values in Git.
# Generate an independent random demo access token of at least 24 characters.
ARCHIVE_DEMO_ACCESS_TOKEN=

# Enable only after the supported small-lookup contract has been verified at home.
ARCHIVE_ENABLE_LAKEHOUSE=0
# These names MUST come from a working aa_good_lookup request, not guesses.
LAKEHOUSE_ACCESSION_PARAM=
LAKEHOUSE_LIMIT_PARAM=

# Enable only for text that has approval for external processing.
ARCHIVE_ENABLE_ELEVENLABS=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_A_ID=
ELEVENLABS_VOICE_B_ID=
ELEVENLABS_ARCHIVIST_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
