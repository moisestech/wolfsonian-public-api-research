{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive Society published conversation recordings, v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordings": { "type": "array", "items": { "$ref": "#/$defs/recording" } }
  },
  "$defs": {
    "revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ms": { "type": "integer", "minimum": 0 },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "mimeType", "durationMs"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://res\\.cloudinary\\.com/dck5rzi4h/video/upload/v[1-9][0-9]*/archive-dreams/audio/reviewed/[a-z0-9-]+/(elevenlabs|notebooklm)/[a-zA-Z0-9-]+/[0-9a-f]{64}/take-[0-9]+\\.mp3$" },
        "sha256": { "$ref": "#/$defs/revision" },
        "mimeType": { "const": "audio/mpeg" },
        "durationMs": { "type": "integer", "minimum": 1 }
      }
    },
    "cue": {
      "type": "object", "additionalProperties": false,
      "required": ["turnId", "speaker", "startMs", "endMs"],
      "properties": {
        "turnId": { "type": "string", "pattern": "^t[0-9]{3,}$" },
        "speaker": { "type": "string", "pattern": "^(object:.+|perspective:archivist)$" },
        "startMs": { "$ref": "#/$defs/ms" },
        "endMs": { "$ref": "#/$defs/ms" }
      }
    },
    "chapter": {
      "type": "object", "additionalProperties": false,
      "required": ["startMs", "label"],
      "properties": {
        "startMs": { "$ref": "#/$defs/ms" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "recording": {
      "type": "object", "additionalProperties": false,
      "required": ["sceneId", "edition", "language", "basisRevision", "takeId", "media"],
      "properties": {
        "sceneId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "edition": { "enum": ["elevenlabs", "notebooklm"] },
        "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[a-zA-Z0-9]{2,8})*$" },
        "basisRevision": { "$ref": "#/$defs/revision" },
        "takeId": { "type": "string", "pattern": "^take-[0-9]+$" },
        "media": { "$ref": "#/$defs/media" },
        "turnCues": { "type": "array", "items": { "$ref": "#/$defs/cue" } },
        "sourceUrls": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "discussionTranscript": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "pattern": "^/demo/archive-society/audio-text/[a-z0-9-]+/[a-zA-Z0-9-]+/[0-9a-f]{64}/take-[0-9]+\\.txt$" },
            "sha256": { "$ref": "#/$defs/revision" }
          }
        },
        "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } }
      },
      "oneOf": [
        {
          "properties": { "edition": { "const": "elevenlabs" } },
          "required": ["turnCues"],
          "not": { "anyOf": [{ "required": ["discussionTranscript"] }, { "required": ["chapters"] }] }
        },
        {
          "properties": { "edition": { "const": "notebooklm" } },
          "required": ["discussionTranscript", "sourceUrls"],
          "not": { "required": ["turnCues"] }
        }
      ]
    }
  }
}
